# Запрашиваем количество строк
n = int(input("Введите количество строк: "))

# Инициализируем пустой список для символов
all_symbols = []

# Цикл для ввода n строк
for _ in range(n):
    stroka = input()
    # Метод extend добавляет все символы строки в список
    all_symbols.extend(stroka)

# Выводим итоговый список
print(all_symbols)
