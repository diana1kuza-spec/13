# Дан список чисел
numbers = [8, 9, 10, 11]

# 1. Заменить второй (по порядку) элемент списка на 17
numbers[1] = 17

# 2. Добавить числа 4, 5 и 6 в конец списка
numbers.extend([4, 5, 6])

# 3. Удалить первый (по порядку) элемент списка
numbers.pop(0)  # или numbers.remove(numbers[0])

# 4. Удвоить список (добавить к нему все его элементы в том же порядке)
numbers.extend(numbers.copy())  # Используем copy(), чтобы не зациклиться

# 5. Вставить число 25 по индексу 3
numbers.insert(3, 25)

# 6. Вывести список с помощью функции print()
print(numbers)
